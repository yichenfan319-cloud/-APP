<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页（原「我的」）。

  版式对照设计稿：
    ┌────────────────────────────┐
    │ [图标] KIPKIP              │  ← 图标在左上角方框内（原先是正上方居中）
    │ KipKip 是一款自动查课 APP… │  ← 应用介绍
    └────────────────────────────┘
    ┌────────────────────────────┐
    │ 公告              点击查看 ›│
    │ 版本                       │
    │ 1.3.6-beta        检查更新 ›│  ← 版本号是副标题，在左
    │ 问题反馈                   ›│
    │ 了解更多        星辰的网站 ›│  ← 右侧文字用强调色
    └────────────────────────────┘

  所有点击行右侧都带箭头，作为"可点"的引导（设计稿里没画）。
  颜色一律走主题变量，日夜模式自动切换。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceScreen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ========== 应用信息卡片 ========== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="?attr/colorSurfaceCard"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- 图标：左上角 -->
                <ImageView
                    android:id="@+id/iv_app_icon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/app_name"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/app_intro"
                    android:textColor="?attr/colorTextHint"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========== 功能列表卡片 ========== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceCard"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 公告 -->
                <LinearLayout
                    android:id="@+id/layout_announcement"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="公告" />

                    <TextView
                        android:id="@+id/tv_announcement_status"
                        style="@style/SettingsRowAction"
                        android:text="点击查看" />

                    <ImageView style="@style/SettingsRowArrow" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- 版本：标题 + 版本号副标题（在左），右侧是动作 -->
                <LinearLayout
                    android:id="@+id/layout_version"
                    style="@style/SettingsRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="版本" />

                        <TextView
                            android:id="@+id/tv_version_name"
                            style="@style/SettingsRowSubtitle"
                            android:text="v1.0" />
                    </LinearLayout>

                    <TextView
                        style="@style/SettingsRowAction"
                        android:text="检查更新" />

                    <ImageView style="@style/SettingsRowArrow" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- 问题反馈 -->
                <LinearLayout
                    android:id="@+id/layout_feedback"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="问题反馈" />

                    <ImageView style="@style/SettingsRowArrow" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <!-- 了解更多 -->
                <LinearLayout
                    android:id="@+id/layout_creator"
                    style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="了解更多" />

                    <TextView
                        android:id="@+id/tv_creator"
                        style="@style/SettingsRowAction"
                        android:text="@string/creator_name" />

                    <ImageView style="@style/SettingsRowArrow" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
