<?xml version="1.0" encoding="utf-8"?>
<!--
  主容器：内容铺满全屏，玻璃导航浮在它上面。

  导航栏整条都由 Compose 画（见 GlassNav.kt）：胶囊底色 + 三个标签 + 一颗
  会停靠、能跟手拖动的液态玻璃珠。珠子折射的就是这条导航栏本身的内容，
  所以它滑到哪里，那里的图标文字就被真实弯掉。

  ComposeView 必须"浮"在页面之上，而且各页面自己留出底部 padding
  （见 fragment_today.xml 等里的 96dp），否则最后一行会被导航压住。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceScreen">

    <!-- 三个页面都塞在这里，用 show/hide 切换，不重建 -->
    <FrameLayout
        android:id="@+id/page_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 隐藏的 WebView 挂在这儿：尺寸为 0，用户看不到，只用来过单点登录 -->
    <FrameLayout
        android:id="@+id/engine_host"
        android:layout_width="0dp"
        android:layout_height="0dp" />

    <!-- 导航栏：高度与 MainActivity 里的 barH 保持一致（64dp） -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/nav_compose"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="18dp" />

</FrameLayout>
